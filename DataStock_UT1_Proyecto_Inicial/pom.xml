<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>es.iesisidra</groupId>
  <artifactId>datastock-ut1</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>DataStock - Proyecto inicial UT1</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <gson.version>2.11.0</gson.version>
    <mysql.connector.version>8.4.0</mysql.connector.version>
    <sqlite.version>3.47.1.0</sqlite.version>
  </properties>
  <dependencies>
    <!-- Para RF-FIC-02 y RF-FIC-05. Gson para intercambio JSON -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
    <!-- UT2: Conector oficial de MySQL para JDBC (RF-JDBC-01 a 08) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.connector.version}</version>
    </dependency>
    <!-- UT2: Conector SQLite para actividad complementaria embebida -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version><configuration><mainClass>es.iesisidra.datastock.App</mainClass></configuration></plugin>
    </plugins>
  </build>
</project>
